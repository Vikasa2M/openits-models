  VEH_INTERVAL_TYPE_YELLOW_CHANGE = 2;
  VEH_INTERVAL_TYPE_RED_CLEAR = 3;
  VEH_INTERVAL_TYPE_RED = 4;
  VEH_INTERVAL_TYPE_DARK = 5;
}

message openits.signal_control.v1.VolumeDensity {
  optional string added_initial_s = 6;
  optional uint32 max_initial_s = 7;
  optional uint32 time_before_reduction_s = 8;
  optional uint32 time_to_reduce_s = 9;
  optional string min_gap_s = 10;
}

message openits.types.v1.ComponentRef {
  string component_class = 1;
  string component_id = 2;
}

enum openits.types.v1.OnBatteryMode {
  ON_BATTERY_MODE_UNSPECIFIED = 0;
  ON_BATTERY_MODE_FULL_OPERATION = 1;
  ON_BATTERY_MODE_FLASH = 2;
}

message openits.types.v1.ScOnBatteryPolicy {
  optional openits.types.v1.OnBatteryMode mode = 1;
  optional uint32 transition_at_soc_pct = 2;
  optional uint32 transition_at_runtime_min = 4;
}
