{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occupancy-count": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "occupied-since": {
      "format": "date-time",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "presence": {
      "type": "boolean"
    },
    "presence-confidence": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "present-class": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string"
          },
          "classification-confidence": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "count": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "sequence": {
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "zone-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "occurred-at",
    "sequence",
    "source-device-id",
    "zone-id"
  ],
  "type": "object"
}