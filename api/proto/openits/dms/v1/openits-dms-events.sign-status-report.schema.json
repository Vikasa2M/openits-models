{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambient-illuminance-lux": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "ambient-light-level": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "brightness-current": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "cabinet-temperature-c": {
      "type": "string"
    },
    "display-state": {
      "type": "string"
    },
    "door-open": {
      "type": "boolean"
    },
    "fan-active": {
      "type": "boolean"
    },
    "heater-active": {
      "type": "boolean"
    },
    "humidity-percent": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sign-face-temperature-c": {
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "occurred-at",
    "sequence",
    "source-device-id"
  ],
  "type": "object"
}