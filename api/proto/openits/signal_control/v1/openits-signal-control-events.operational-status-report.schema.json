{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active-fault-count": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "cabinet-output": {
      "enum": [
        "dark",
        "flash",
        "normal",
        "unknown"
      ],
      "type": "string"
    },
    "cabinet-output-since": {
      "format": "date-time",
      "type": "string"
    },
    "control-source": {
      "type": "string"
    },
    "flash-cause": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "mode-since": {
      "format": "date-time",
      "type": "string"
    },
    "monitor-status": {
      "enum": [
        "fault",
        "not-equipped",
        "not-read",
        "ok",
        "unknown"
      ],
      "type": "string"
    },
    "observed-at": {
      "format": "date-time",
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "oper-status": {
      "enum": [
        "degraded",
        "failed",
        "not-present",
        "ok",
        "unknown"
      ],
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "preempt-active": {
      "type": "boolean"
    },
    "priority-active": {
      "type": "boolean"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "uptime-s": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "occurred-at",
    "sequence",
    "sequence-epoch",
    "source-device-id"
  ],
  "type": "object"
}