{
  "$defs": {
    "WireSource": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "type": "string"
        },
        "indiana-code": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "indiana-param": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "message-id": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "oid": {
          "type": "string"
        },
        "oid-value": {
          "type": "string"
        },
        "register": {
          "type": "string"
        },
        "register-value": {
          "type": "string"
        }
      },
      "required": [
        "decoder"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "face": {
      "type": "string"
    },
    "indication": {
      "enum": [
        "dark",
        "flashing-yellow-x",
        "green-arrow",
        "red-x",
        "unknown",
        "white-one-way-left-turn-arrow",
        "white-two-way-left-turn-arrow",
        "yellow-x"
      ],
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "lane-id": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "previous-indication": {
      "enum": [
        "dark",
        "flashing-yellow-x",
        "green-arrow",
        "red-x",
        "unknown",
        "white-one-way-left-turn-arrow",
        "white-two-way-left-turn-arrow",
        "yellow-x"
      ],
      "type": "string"
    },
    "segment-id": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/WireSource"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    }
  },
  "required": [
    "face",
    "indication",
    "kind",
    "lane-id",
    "occurred-at",
    "segment-id",
    "sequence",
    "sequence-epoch",
    "source-device-id"
  ],
  "type": "object"
}