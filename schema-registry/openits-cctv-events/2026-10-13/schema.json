{
  "lockout-denied": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current-holder": {
      "type": "string"
    },
    "held-priority": {
      "maximum": 255,
      "minimum": 1,
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "requested-by": {
      "type": "string"
    },
    "requested-priority": {
      "maximum": 255,
      "minimum": 1,
      "type": "integer"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "occurred-at",
    "requested-by",
    "sequence",
    "sequence-epoch",
    "source-device-id"
  ],
  "type": "object"
},
  "ptz-move-commanded": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absolute": {
      "additionalProperties": false,
      "properties": {
        "pan-degrees": {
          "type": "string"
        },
        "tilt-degrees": {
          "type": "string"
        },
        "zoom-percent": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "commanded-by": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "move-mode": {
      "enum": [
        "absolute",
        "idle",
        "preset",
        "tour",
        "velocity"
      ],
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "velocity": {
      "additionalProperties": false,
      "properties": {
        "pan-speed": {
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        },
        "tilt-speed": {
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        },
        "zoom-speed": {
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "kind",
    "move-mode",
    "occurred-at",
    "sequence",
    "sequence-epoch",
    "source-device-id"
  ],
  "type": "object"
},
  "ptz-preset-recalled": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "preset-id": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "preset-name": {
      "type": "string"
    },
    "recalled-by": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "via-tour": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "occurred-at",
    "preset-id",
    "sequence",
    "sequence-epoch",
    "source-device-id"
  ],
  "type": "object"
},
  "tour-state-changed": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current-state": {
      "enum": [
        "paused",
        "running",
        "stopped"
      ],
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "previous-state": {
      "enum": [
        "paused",
        "running",
        "stopped"
      ],
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "tour-id": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "current-state",
    "kind",
    "occurred-at",
    "sequence",
    "sequence-epoch",
    "source-device-id",
    "tour-id"
  ],
  "type": "object"
}
}
