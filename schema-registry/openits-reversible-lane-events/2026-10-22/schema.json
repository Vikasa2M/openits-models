{
  "gate-status-changed": {
  "$defs": {
    "WireSource": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "type": "string"
        },
        "indiana-code": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "indiana-param": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "message-id": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "oid": {
          "type": "string"
        },
        "oid-value": {
          "type": "string"
        },
        "register": {
          "type": "string"
        },
        "register-value": {
          "type": "string"
        }
      },
      "required": [
        "decoder"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "close-inhibited": {
      "type": "boolean"
    },
    "control-source": {
      "type": "string"
    },
    "gate-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "interlock-bypassed": {
      "type": "boolean"
    },
    "kind": {
      "type": "string"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "open-inhibited": {
      "type": "boolean"
    },
    "operating-mode": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "position": {
      "enum": [
        "closed",
        "closing",
        "intermediate",
        "open",
        "opening",
        "unknown"
      ],
      "type": "string"
    },
    "previous-operating-mode": {
      "type": "string"
    },
    "previous-position": {
      "enum": [
        "closed",
        "closing",
        "intermediate",
        "open",
        "opening",
        "unknown"
      ],
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence-epoch": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/WireSource"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    }
  },
  "required": [
    "gate-id",
    "kind",
    "occurred-at",
    "position",
    "sequence",
    "sequence-epoch",
    "source-device-id"
  ],
  "type": "object"
},
