message openits.rsu.v1.SampleBasis {
  optional openits.rsu.v1.StatsWindowType window_type = 1;
  optional uint32 stats_window_seconds = 2;
  optional uint32 sample_count = 3;
  optional string penetration_estimate_pct = 4;
  google.protobuf.Timestamp observed_at = 6;
}

enum openits.rsu.v1.SignalQuality {
  SIGNAL_QUALITY_EXCELLENT = 0;
  SIGNAL_QUALITY_GOOD = 1;
  SIGNAL_QUALITY_FAIR = 2;
  SIGNAL_QUALITY_POOR = 3;
  SIGNAL_QUALITY_NONE = 4;
}

message openits.rsu.v1.Spat {
  openits.rsu.v1.SpatConfig config = 1;
  openits.rsu.v1.SpatState state = 2;
}

message openits.rsu.v1.SpatConfig {
  optional bool enabled = 1;
  optional uint32 broadcast_interval = 2;
  optional string source_asc = 3;
  optional openits.rsu.v1.BroadcastSourceMode source_mode = 4;
  optional bool include_timing_prediction = 5;
  optional uint32 max_data_age_ms = 6;
  repeated openits.rsu.v1.SpatConfigIntersection intersection = 7;
  openits.rsu.v1.SpatConfigIngest ingest = 8;
  optional uint32 psid = 9;
}

message openits.rsu.v1.SpatConfigIngest {
  optional openits.rsu.v1.IngestTransport transport = 1;
  optional string address = 2;
  optional uint32 port = 3;
  optional uint32 psid = 4;
}

message openits.rsu.v1.SpatConfigIntersection {
  optional uint32 id = 1;
  optional uint32 region = 2;
}

message openits.rsu.v1.SpatState {
  optional bool broadcasting = 1;
  optional uint64 broadcast_count = 2;
  google.protobuf.Timestamp last_broadcast = 3;
  optional bool asc_connected = 4;
  optional bool halted_stale = 5;
}

message openits.rsu.v1.SpatSync {
  optional uint32 asc_poll_interval_ms = 2;
  google.protobuf.Timestamp last_asc_update = 3;
  optional uint32 phase_mismatch_count = 4;
  optional uint32 timing_mismatch_count = 5;
  optional uint64 total_spat_generated = 6;
  optional uint32 sync_quality_pct = 7;
  optional uint32 avg_data_age_ms = 8;
  optional uint32 min_yellow_violation = 9;
  optional uint32 max_green_exceeded = 10;
  optional uint32 phase_gap_errors = 11;
}

message openits.rsu.v1.SpeedMetrics {
  optional string average_kmh = 1;
  optional string median_kmh = 2;
  optional string percentile_85_kmh = 3;
  optional string percentile_95_kmh = 4;
}

enum openits.rsu.v1.SrmRequestStatus {
  SRM_REQUEST_STATUS_PENDING = 0;
  SRM_REQUEST_STATUS_APPROVED = 1;
  SRM_REQUEST_STATUS_ACTIVE = 2;
  SRM_REQUEST_STATUS_COMPLETED = 3;
  SRM_REQUEST_STATUS_DENIED = 4;
}

message openits.rsu.v1.SrmSsm {
  openits.rsu.v1.SrmSsmConfig config = 1;
  openits.rsu.v1.SrmSsmState state = 2;
  openits.rsu.v1.ActiveRequests active_requests = 3;
  openits.rsu.v1.Decisions decisions = 4;
}

message openits.rsu.v1.SrmSsmConfig {
  optional bool srm_receive_enabled = 1;
  optional bool ssm_broadcast_enabled = 2;
  optional bool forward_to_asc = 3;
  optional string asc_device = 4;
  optional bool auto_approve_tsp = 5;
  optional uint32 max_active_requests = 6;
  optional openits.rsu.v1.GrantAuthority grant_authority = 7;
  optional bool evp_auto_grant = 8;
  optional uint32 psid = 9;
}

message openits.rsu.v1.SrmSsmState {
  optional uint64 srm_received = 1;
  optional uint64 ssm_broadcast = 2;
  optional uint32 active_requests = 3;
  optional uint64 approved_requests = 4;
  optional uint64 denied_requests = 5;
}

enum openits.rsu.v1.StatsWindowType {
  STATS_WINDOW_TYPE_ROLLING = 0;
  STATS_WINDOW_TYPE_TUMBLING = 1;
}

message openits.rsu.v1.StoreForward {
  openits.rsu.v1.StoreForwardConfig config = 1;
  openits.rsu.v1.StoreForwardState state = 2;
}

message openits.rsu.v1.StoreForwardConfig {
  optional bool enabled = 1;
  optional uint32 max_messages = 2;
  optional uint32 max_age = 3;
  optional bool forward_on_connect = 4;
}

message openits.rsu.v1.StoreForwardState {
  optional uint32 stored_messages = 1;
  optional uint32 storage_used_percent = 2;
  optional uint64 messages_forwarded_today = 3;
  optional uint32 oldest_message_age = 4;
}

message openits.rsu.v1.SurveyedPosition {
  optional string latitude = 1;
  optional string longitude = 2;
}

message openits.rsu.v1.System {
  repeated openits.rsu.v1.CommLink comm_link = 1;
}

message openits.rsu.v1.TemperatureSensor {
  optional uint32 id = 1;
  optional string name = 2;
  optional string temperature_c = 3;
  optional string status = 4;
  optional string threshold_high_c = 5;
  optional string threshold_low_c = 6;
}

message openits.rsu.v1.Tim {
  openits.rsu.v1.TimConfig config = 1;
  openits.rsu.v1.Active active = 2;
}

message openits.rsu.v1.TimConfig {
  optional bool enabled = 1;
  optional uint32 max_active_messages = 2;
  optional bool suppress_expired = 3;
}

message openits.rsu.v1.VehicleAnalytics {
  openits.rsu.v1.Counts counts = 1;
  openits.rsu.v1.SpeedMetrics speed_metrics = 2;
  openits.rsu.v1.VehicleClassBreakdown vehicle_class_breakdown = 3;
  repeated openits.rsu.v1.Approach approach = 4;
  openits.rsu.v1.SampleBasis sample_basis = 5;
}

message openits.rsu.v1.VehicleClassBreakdown {
  optional uint32 passenger_pct = 1;
  optional uint32 truck_pct = 2;
  optional uint32 emergency_pct = 3;
  optional uint32 transit_pct = 4;
}

message openits.rsu.v1.Warnings {
  optional uint64 count_1h = 1;
  optional uint64 count_24h = 2;
}

message openits.types.v1.ComponentRef {
  string component_class = 1;
  string component_id = 2;
}
